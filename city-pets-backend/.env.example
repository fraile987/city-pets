# Copia este archivo a .env y rellena los valores.
# .env NO se sube a git; .env.example sirve como referencia.

# Conexión a la base de datos (Prisma/SQLite)
DATABASE_URL="file:./dev.db"

# Secreto para firmar los tokens JWT.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-seguro"

# Orígenes CORS permitidos (separados por coma). Vacío = desarrollo
# (permite localhost/127.0.0.1 en cualquier puerto). En producción define
# aquí el dominio exacto, p. ej. https://citypets.example.com
CORS_ORIGINS=""