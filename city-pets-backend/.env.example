# Copia este archivo a .env y rellena los valores.
# .env NO se sube a git; .env.example sirve como referencia.

# Entorno de ejecución: 'development' (por defecto) o 'production'.
# Cualquier otro valor aborta el arranque (fail-fast).
# Desarrollo:  NODE_ENV=development   (default, permite localhost/127.0.0.1)
# Producción:  NODE_ENV=production    (solo CORS_ORIGINS, HSTS activo)
NODE_ENV=development

# Puerto del servidor. En desarrollo por defecto 3000.
PORT=3000

# Interfaz de escucha (Fase 9.6). Si se deja vacío:
#   development -> 0.0.0.0   (accesible desde la red local)
#   production  -> 127.0.0.1 (solo nginx expone el servicio)
# Producción escuchando en 0.0.0.0/:: aborta el arranque (fail-fast).
HOST=

# Conexión a la base de datos (Prisma/SQLite).
# Desarrollo:   ruta relativa al directorio prisma/ (file:./dev.db).
# Producción:   ruta ABSOLUTA en un volumen fuera del código, p. ej.
#   DATABASE_URL="file:/var/lib/city-pets/data/dev.db"
DATABASE_URL="file:./dev.db"

# Directorio de medios subidos (Fase 9.6). Si se deja vacío, usa
# ./uploads dentro del backend. En producción apunta a un volumen
# fuera del código, p. ej. /var/lib/city-pets/uploads.
UPLOADS_PATH=

# Secreto para firmar los tokens JWT. Mínimo 16 caracteres; el arranque aborta
# si falta, es demasiado débil o sigue siendo el placeholder.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-secreto-seguro"

# Orígenes CORS permitidos, separados por coma. NO admite "*".
# Desarrollo: localhost/127.0.0.1 ya están permitidos; aquí puedes añadir otros.
# Producción: lista exacta de orígenes. Vacía en producción aborta el arranque.
#   CORS_ORIGINS=https://citypets.com,https://www.citypets.com
CORS_ORIGINS=""

# Recuperación de contraseña (Fase D1).
# URL pública para construir el enlace de recuperación (se usa en desarrollo;
# en producción el enlace no se expone en la API).
APP_URL="http://localhost:3000"

# --- SMTP (Fase D3: envío real del correo de recuperación) ---
# Obligatorias en PRODUCCIÓN para poder enviar el enlace. Sin ellas no se
# crea ningún token de recuperación activo (la API responde igual de genérico).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
